<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BancoAlimentos.Avalonia.ViewModels"
             xmlns:models="using:BancoAlimentos.Avalonia.Models"
             x:Class="BancoAlimentos.Avalonia.Views.ProductosView"
             x:DataType="vm:ProductosViewModel">

    <Grid ColumnDefinitions="*,20,Auto">

        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0" Classes="tarjeta" Padding="14,12" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto">
                    <Button Grid.Column="0" Classes="primario" Content="Nuevo alimento"
                            Command="{Binding NuevoCommand}"/>
                    <Button Grid.Column="2" Classes="secundario" Content="Editar"
                            Command="{Binding EditarCommand}" IsEnabled="{Binding HaySeleccion}"/>
                    <Button Grid.Column="4" Classes="peligro" Content="Eliminar"
                            Command="{Binding EliminarCommand}" IsEnabled="{Binding HaySeleccion}"/>
                    <CheckBox Grid.Column="5" Content="Ver inactivos" Margin="18,0,0,0"
                              VerticalAlignment="Center" FontSize="12"
                              IsChecked="{Binding MostrarInactivos}"/>
                    <Button Grid.Column="6" Classes="secundario" Content="Actualizar"
                            Command="{Binding CargarCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="tarjeta" Padding="0">
                <DataGrid ItemsSource="{Binding Productos}"
                          SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ALIMENTO" Binding="{Binding Nombre}" Width="2*" MinWidth="120"/>
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}" Width="1.5*" MinWidth="120"/>
                        <DataGridTextColumn Header="UNIDAD" Binding="{Binding UnidadNombre}" Width="1.1*" MinWidth="105"/>
                        <DataGridTextColumn Header="ALERTA (DÍAS)" Binding="{Binding DiasAlertaVencimiento}" Width="150"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Producto">
                                    <Border Classes="distintivo"
                                            Classes.ok="{Binding Activo}"
                                            Classes.peligro="{Binding !Activo}">
                                        <TextBlock Text="{Binding Activo, Converter={x:Static vm:Convertidores.ActivoInactivo}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="2" Classes="mensaje" Text="{Binding Mensaje}" Margin="0,12,0,0"
                       IsVisible="{Binding Mensaje, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>

        <Border Grid.Column="2" Classes="tarjeta" Width="310" VerticalAlignment="Stretch"
                IsVisible="{Binding EditorVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                    <TextBlock Classes="subtitulo" Text="{Binding TituloEditor}"/>
                    <TextBlock Classes="apagado" Margin="0,0,0,6" Text="Enter guarda, Esc cancela."/>

                    <TextBlock Classes="campo" Text="NOMBRE DEL ALIMENTO *"/>
                    <TextBox Text="{Binding EdNombre}" Watermark="Ej. Arroz, Frijoles, Aceite" TabIndex="1"/>

                    <TextBlock Classes="campo" Text="CATEGORÍA *"/>
                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding EdCategoria}"
                              HorizontalAlignment="Stretch" TabIndex="2"/>

                    <TextBlock Classes="campo" Text="UNIDAD DE MEDIDA *"/>
                    <ComboBox ItemsSource="{Binding Unidades}" SelectedItem="{Binding EdUnidad}"
                              HorizontalAlignment="Stretch" TabIndex="3"/>

                    <TextBlock Classes="campo" Text="AVISAR CUÁNTOS DÍAS ANTES DE VENCER *"/>
                    <NumericUpDown Value="{Binding EdDiasAlerta}" Minimum="0" Maximum="365"
                                   FormatString="0" TabIndex="4"/>
                    <TextBlock Classes="apagado" TextWrapping="Wrap"
                               Text="Un lote pasa a «Por vencer» cuando le queden estos días o menos."/>

                    <CheckBox Content="Activo" IsChecked="{Binding EdActivo}"
                              Margin="0,10,0,0" TabIndex="5"/>

                    <Grid ColumnDefinitions="*,10,*" Margin="0,14,0,0">
                        <Button Grid.Column="0" Classes="primario" Content="Guardar"
                                Command="{Binding GuardarCommand}"
                                HorizontalAlignment="Stretch" Height="40" TabIndex="6"/>
                        <Button Grid.Column="2" Classes="secundario" Content="Cancelar"
                                Command="{Binding CancelarCommand}"
                                HorizontalAlignment="Stretch" Height="40" TabIndex="7"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

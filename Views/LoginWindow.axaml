<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BancoAlimentos.Avalonia.ViewModels"
        xmlns:ctrl="using:BancoAlimentos.Avalonia.Controls"
        x:Class="BancoAlimentos.Avalonia.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Width="480" Height="680"
        MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppSurface}"
        Title="Banco de Alimentos Solidarios - Acceso">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource BrandPrimary}" Padding="32,26">
            <Grid ColumnDefinitions="Auto,*">
                <ctrl:LogoBanco Grid.Column="0" Width="46" Height="46" Margin="0,0,14,0"
                                VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Banco de Alimentos" Foreground="White"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Solidarios" Foreground="{DynamicResource TextOnBrand}"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Sistema de Gestión de Donaciones"
                               Foreground="{DynamicResource TextOnBrand}" FontSize="12"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TabControl Classes="segmentado" Margin="28,22"
                        SelectedIndex="{Binding PestanaActiva}">

                <TabItem Header="Iniciar sesión">
                    <StackPanel Spacing="6" Margin="0,18,0,0">

                        <TextBlock Classes="campo" Text="USUARIO"/>
                        <TextBox x:Name="CampoUsuario" Text="{Binding NombreUsuario}"
                                 Watermark="Ingrese su usuario" TabIndex="1"/>

                        <TextBlock Classes="campo" Text="CONTRASEÑA"/>
                        <TextBox Text="{Binding Contrasena}" PasswordChar="*"
                                 Watermark="Ingrese su contraseña" TabIndex="2"/>

                        <Border Background="{DynamicResource StateDangerSoft}" CornerRadius="6"
                                Padding="12,9" Margin="0,10,0,0"
                                IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="error" Text="{Binding MensajeError}"/>
                        </Border>

                        <Border Background="{DynamicResource StateSuccessSoft}" CornerRadius="6"
                                Padding="12,9" Margin="0,10,0,0"
                                IsVisible="{Binding RegMensajeExito, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="mensaje" Text="{Binding RegMensajeExito}"
                                       Foreground="{DynamicResource StateSuccess}"/>
                        </Border>

                        <Button Classes="primario" Content="Iniciar sesión" TabIndex="3"
                                Command="{Binding IniciarSesionCommand}"
                                HorizontalAlignment="Stretch" Height="44" Margin="0,16,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Crear cuenta">
                    <StackPanel Spacing="6" Margin="0,18,0,0">

                        <TextBlock Classes="campo" Text="NOMBRE COMPLETO"/>
                        <TextBox Text="{Binding RegNombreCompleto}"
                                 Watermark="Ej. Ana Lucía Ramírez" TabIndex="1"/>

                        <TextBlock Classes="campo" Text="USUARIO"/>
                        <TextBox Text="{Binding RegNombreUsuario}"
                                 Watermark="Mínimo 4 caracteres" TabIndex="2"/>

                        <TextBlock Classes="campo" Text="CONTRASEÑA"/>
                        <TextBox Text="{Binding RegContrasena}" PasswordChar="●"
                                 Watermark="Mínimo 8 caracteres" TabIndex="3"/>

                        <TextBlock Classes="campo" Text="CONFIRMAR CONTRASEÑA"/>
                        <TextBox Text="{Binding RegConfirmacion}" PasswordChar="●"
                                 Watermark="Repita la contraseña" TabIndex="4"/>

                        <Border Background="{DynamicResource StateDangerSoft}" CornerRadius="6"
                                Padding="12,9" Margin="0,10,0,0"
                                IsVisible="{Binding RegMensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="error" Text="{Binding RegMensajeError}"/>
                        </Border>

                        <Button Classes="primario" Content="Crear cuenta" TabIndex="5"
                                Command="{Binding RegistrarCommand}"
                                HorizontalAlignment="Stretch" Height="44" Margin="0,16,0,0"/>

                        <TextBlock Classes="apagado" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Las cuentas nuevas se crean con rol Operador. La contraseña se guarda cifrada (PBKDF2)."/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </ScrollViewer>
    </Grid>
</Window>

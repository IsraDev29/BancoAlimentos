<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BancoAlimentos.Avalonia.ViewModels"
             xmlns:models="using:BancoAlimentos.Avalonia.Models"
             x:Class="BancoAlimentos.Avalonia.Views.BeneficiariosView"
             x:DataType="vm:BeneficiariosViewModel">

    <Grid Margin="24" ColumnDefinitions="*,20,Auto">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,14,*,14,*" Margin="0,0,0,14">
                <Border Grid.Column="0" Classes="tarjeta" Padding="18,14">
                    <StackPanel>
                        <TextBlock Classes="metricaEtiqueta" Text="TOTAL"/>
                        <TextBlock Classes="metrica" Text="{Binding TotalBeneficiarios}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="tarjeta" Padding="18,14">
                    <StackPanel>
                        <TextBlock Classes="metricaEtiqueta" Text="COMEDORES"
                                   Foreground="{DynamicResource StateSuccess}"/>
                        <TextBlock Classes="metrica" Text="{Binding TotalComedores}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource StateSuccess}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="tarjeta" Padding="18,14">
                    <StackPanel>
                        <TextBlock Classes="metricaEtiqueta" Text="ONG"
                                   Foreground="{DynamicResource StateWarning}"/>
                        <TextBlock Classes="metrica" Text="{Binding TotalOng}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource StateWarning}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Classes="tarjeta" Padding="14,12" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto">
                    <Button Grid.Column="0" Classes="primario" Content="Nuevo beneficiario"
                            Command="{Binding NuevoCommand}"/>
                    <Button Grid.Column="2" Classes="secundario" Content="Editar"
                            Command="{Binding EditarCommand}" IsEnabled="{Binding HaySeleccion}"/>
                    <Button Grid.Column="4" Classes="peligro" Content="Eliminar"
                            Command="{Binding EliminarCommand}" IsEnabled="{Binding HaySeleccion}"/>
                    <CheckBox Grid.Column="5" Content="Ver inactivos" Margin="18,0,0,0"
                              VerticalAlignment="Center" FontSize="12"
                              IsChecked="{Binding MostrarInactivos}"/>
                    <Button Grid.Column="6" Classes="secundario" Content="Actualizar"
                            Command="{Binding CargarCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="tarjeta" Padding="0">
                <DataGrid ItemsSource="{Binding Beneficiarios}"
                          SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="2*" MinWidth="120"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="1.2*" MinWidth="110"/>
                        <DataGridTextColumn Header="DIRECCIÓN" Binding="{Binding Direccion}" Width="1.8*" MinWidth="110"/>
                        <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="115"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:Beneficiario">
                                    <Border Classes="distintivo"
                                            Classes.ok="{Binding Activo}"
                                            Classes.peligro="{Binding !Activo}">
                                        <TextBlock Text="{Binding Activo, Converter={x:Static vm:Convertidores.ActivoInactivo}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="3" Classes="mensaje" Text="{Binding Mensaje}" Margin="0,12,0,0"
                       IsVisible="{Binding Mensaje, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>

        <Border Grid.Column="2" Classes="tarjeta" Width="310" VerticalAlignment="Stretch"
                IsVisible="{Binding EditorVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                    <TextBlock Classes="subtitulo" Text="{Binding TituloEditor}"/>
                    <TextBlock Classes="apagado" Margin="0,0,0,6" Text="Enter guarda, Esc cancela."/>

                    <TextBlock Classes="campo" Text="NOMBRE *"/>
                    <TextBox Text="{Binding EdNombre}" Watermark="Nombre del comedor u organización" TabIndex="1"/>

                    <TextBlock Classes="campo" Text="TIPO *"/>
                    <ComboBox ItemsSource="{Binding TiposDisponibles}" SelectedItem="{Binding EdTipo}"
                              HorizontalAlignment="Stretch" TabIndex="2"/>

                    <TextBlock Classes="campo" Text="RESPONSABLE DE CONTACTO"/>
                    <TextBox Text="{Binding EdResponsable}" Watermark="Nombre de la persona" TabIndex="3"/>

                    <TextBlock Classes="campo" Text="TELÉFONO"/>
                    <TextBox Text="{Binding EdTelefono}" Watermark="2233-4455" TabIndex="4"/>

                    <TextBlock Classes="campo" Text="DIRECCIÓN"/>
                    <TextBox Text="{Binding EdDireccion}" AcceptsReturn="True" Height="60"
                             TextWrapping="Wrap" Watermark="Opcional" TabIndex="5"/>

                    <CheckBox Content="Activo" IsChecked="{Binding EdActivo}"
                              Margin="0,10,0,0" TabIndex="6"/>

                    <Grid ColumnDefinitions="*,10,*" Margin="0,14,0,0">
                        <Button Grid.Column="0" Classes="primario" Content="Guardar"
                                Command="{Binding GuardarCommand}"
                                HorizontalAlignment="Stretch" Height="40" TabIndex="7"/>
                        <Button Grid.Column="2" Classes="secundario" Content="Cancelar"
                                Command="{Binding CancelarCommand}"
                                HorizontalAlignment="Stretch" Height="40" TabIndex="8"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

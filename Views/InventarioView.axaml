<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BancoAlimentos.Avalonia.ViewModels"
             xmlns:views="using:BancoAlimentos.Avalonia.Views"
             xmlns:models="using:BancoAlimentos.Avalonia.Models"
             x:Class="BancoAlimentos.Avalonia.Views.InventarioView"
             x:DataType="vm:InventarioViewModel">

    <Grid Margin="24" RowDefinitions="Auto,*">

        <!-- Selector entre existencias y catálogo de alimentos -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Classes="segmento" Classes.activo="{Binding MostrandoExistencias}"
                    Command="{Binding VerExistenciasCommand}"
                    Content="Existencias" MinWidth="140" HorizontalContentAlignment="Center"/>
            <Button Classes="segmento" Classes.activo="{Binding MostrandoAlimentos}"
                    Command="{Binding VerAlimentosCommand}"
                    Content="Catálogo de alimentos" MinWidth="190" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <!-- Existencias -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" IsVisible="{Binding MostrandoExistencias}">
            <Border Grid.Row="0" Classes="tarjeta" Padding="14,12" Margin="0,0,0,14">
                <Grid ColumnDefinitions="*,12,200,12,130">
                    <TextBox Grid.Column="0" Text="{Binding FiltroTexto}"
                             Watermark="Buscar por producto o donante..."/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding EstadosDisponibles}"
                              SelectedItem="{Binding EstadoSeleccionado}"
                              HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="4" Classes="primario" Content="Actualizar"
                            Command="{Binding CargarCommand}" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="tarjeta" Padding="0">
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Producto}" Width="1.6*" MinWidth="140"/>
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}" Width="1.3*" MinWidth="130"/>
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadDisponible}" Width="125"/>
                        <DataGridTextColumn Header="UNIDAD" Binding="{Binding Unidad}" Width="105"/>
                        <DataGridTextColumn Header="EMPAQUE" Binding="{Binding DescripcionEmpaque}" Width="130"/>
                        <DataGridTextColumn Header="VENCE" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="DONANTE" Binding="{Binding Donante}" Width="1.5*" MinWidth="140"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:InventarioItem">
                                    <Border Classes="distintivo"
                                            Classes.ok="{Binding EstadoEsVigente}"
                                            Classes.aviso="{Binding EstadoEsPorVencer}"
                                            Classes.peligro="{Binding EstadoEsVencido}">
                                        <TextBlock Text="{Binding Estado}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="2" Classes="mensaje" Text="{Binding Mensaje}" Margin="0,12,0,0"
                       IsVisible="{Binding Mensaje, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>

        <!-- Catálogo de alimentos (CRUD) -->
        <ContentControl Grid.Row="1" IsVisible="{Binding MostrandoAlimentos}">
            <views:ProductosView DataContext="{Binding ProductosVm}"/>
        </ContentControl>
    </Grid>
</UserControl>

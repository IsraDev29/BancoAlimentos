<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BancoAlimentos.Avalonia.ViewModels"
             xmlns:models="using:BancoAlimentos.Avalonia.Models"
             x:Class="BancoAlimentos.Avalonia.Views.DistribucionView"
             x:DataType="vm:DistribucionViewModel">

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="tarjeta" Padding="18,16" Margin="0,0,0,16">
            <Grid ColumnDefinitions="2*,16,3*,16,Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="campo" Text="BENEFICIARIO (COMEDOR / ONG)"/>
                    <ComboBox ItemsSource="{Binding Beneficiarios}"
                              SelectedItem="{Binding BeneficiarioSeleccionado}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Seleccione un beneficiario"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="campo" Text="OBSERVACIONES"/>
                    <TextBox Text="{Binding Observaciones}" Watermark="Opcional"/>
                </StackPanel>
                <Button Grid.Column="4" Classes="secundario" Content="Actualizar inventario"
                        Command="{Binding CargarCommand}" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="tarjeta" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Margin="18,14,18,12">
                    <TextBlock Classes="subtitulo" Text="Lotes disponibles"/>
                    <TextBlock Classes="apagado"
                               Text="Escriba la cantidad a entregar en la última columna. Los lotes vencidos no se muestran."/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding LotesDisponibles}"
                          AutoGenerateColumns="False" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Producto}" Width="1.6*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadDisponible}" Width="125" IsReadOnly="True"/>
                        <DataGridTextColumn Header="UNIDAD" Binding="{Binding Unidad}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="VENCE" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:InventarioItem">
                                    <Border Classes="distintivo"
                                            Classes.ok="{Binding EstadoEsVigente}"
                                            Classes.aviso="{Binding EstadoEsPorVencer}">
                                        <TextBlock Text="{Binding Estado}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="A ENTREGAR" Binding="{Binding CantidadAEntregar}" Width="150" IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0" Classes="mensaje" Text="{Binding Mensaje}"
                       VerticalAlignment="Center" Margin="0,0,16,0"
                       IsVisible="{Binding Mensaje, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Button Grid.Column="1" Classes="primario" Content="Registrar entrega"
                    Command="{Binding RegistrarEntregaCommand}"
                    Padding="26,11" Height="42"/>
        </Grid>
    </Grid>
</UserControl>

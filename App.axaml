<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BancoAlimentos.Avalonia.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://BancoAlimentos.Avalonia/Styles/AppStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>

            <!-- Identidad institucional -->
            <SolidColorBrush x:Key="BrandPrimary"       Color="#1E3A5F"/>
            <SolidColorBrush x:Key="BrandPrimaryDark"   Color="#14293F"/>
            <SolidColorBrush x:Key="BrandAccent"        Color="#2563EB"/>
            <SolidColorBrush x:Key="BrandAccentHover"   Color="#1D4ED8"/>
            <SolidColorBrush x:Key="BrandAccentPressed" Color="#1E40AF"/>
            <SolidColorBrush x:Key="BrandLight"         Color="#E8EEF7"/>

            <!-- Superficies y texto -->
            <SolidColorBrush x:Key="AppCanvas"          Color="#F1F5F9"/>
            <SolidColorBrush x:Key="AppSurface"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppBorder"          Color="#E2E8F0"/>
            <SolidColorBrush x:Key="TextPrimary"        Color="#0F172A"/>
            <SolidColorBrush x:Key="TextMuted"          Color="#64748B"/>
            <SolidColorBrush x:Key="TextOnBrand"        Color="#CBD9EC"/>

            <!-- Estados de vencimiento -->
            <SolidColorBrush x:Key="StateSuccess"       Color="#047857"/>
            <SolidColorBrush x:Key="StateSuccessSoft"   Color="#D1FAE5"/>
            <SolidColorBrush x:Key="StateWarning"       Color="#B45309"/>
            <SolidColorBrush x:Key="StateWarningSoft"   Color="#FEF3C7"/>
            <SolidColorBrush x:Key="StateDanger"        Color="#B91C1C"/>
            <SolidColorBrush x:Key="StateDangerSoft"    Color="#FEE2E2"/>

        </ResourceDictionary>
    </Application.Resources>

</Application>
